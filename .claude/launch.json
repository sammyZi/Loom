{
  "version": "0.0.1",
  "autoPort": false,
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "-p", "cli"],
      "port": 8080
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "website",
        "run",
        "dev"
      ],
      "port": 3007
    }
  ]
}
